# Test Environment Variables
# These values are automatically set by pytest fixtures in tests/conftest.py
# This file serves as documentation for what test values are used
# DO NOT load this file directly - it's for reference only

# =============================================================================
# Provider-Specific Model Configuration (018-separate-provider-configs)
# =============================================================================
# Models are now configured per-provider in separate environment variables.
# Each model only needs: id, name, description (no provider or default fields)

# OpenAI Models
OPENAI_MODELS='[{"id": "gpt-3.5-turbo", "name": "GPT-3.5 Turbo", "description": "Fast and efficient for most tasks"}]'

# Anthropic Models (optional - not needed for basic tests)
# ANTHROPIC_MODELS='[{"id": "claude-3-haiku", "name": "Claude 3 Haiku", "description": "Fast and efficient"}]'

# Default Model Selection
# Specify which model ID to use as the default (must exist in one of the provider configs)
DEFAULT_MODEL=gpt-3.5-turbo

# =============================================================================
# API Keys for testing
# =============================================================================
OPENAI_API_KEY=test-api-key-12345

# Note: Tests use mocked LLM responses and don't make real API calls
# The API key above is a dummy value that never gets used
